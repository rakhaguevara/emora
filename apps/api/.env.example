PORT=4000

# Supabase (Project Settings > API). SERVICE_ROLE hanya untuk backend, jangan pernah ke frontend.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Kunci yang harus dikirim ESP32 di header x-device-key saat POST /ingest
INGEST_API_KEY=ganti-dengan-string-acak

# MQTT (opsional). Kosongkan MQTT_URL untuk menonaktifkan.
# Contoh broker: HiveMQ Cloud (mqtts://xxxx.s1.eu.hivemq.cloud:8883) atau Mosquitto lokal (mqtt://localhost:1883)
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=emora/+/telemetry

# Dipakai simulator
SIM_API_URL=http://localhost:4000
SIM_DEVICE_ID=emora-01
SIM_INTERVAL_MS=2000
